{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "scripts/docs/*.mjs"],
      "project": ["scripts/**/*.mjs", "e2e/*.ts", "*.config.{ts,mjs}"],
      "ignore": ["scripts/planning/**"]
    },
    "apps/daemon": {
      "entry": ["src/bootstrap/main.ts", "test/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "apps/web": {
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "apps/desktop": {
      "project": ["src/**/*.ts"]
    },
    "packages/shared": {
      "project": ["src/**/*.ts"]
    },
    "packages/agent-adapter": {
      "entry": ["src/smoke.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "packages/config": {
      "project": []
    }
  }
}
